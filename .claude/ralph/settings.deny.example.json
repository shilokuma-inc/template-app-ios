{
  "_comment": "`.claude/settings.local.json` にコピーして使う。bypassPermissions 下でも deny は常に優先される。保護ブランチ名はプロジェクトに合わせて書き換えること。",
  "permissions": {
    "deny": [
      "Bash(git push origin develop:*)",
      "Bash(git push origin main:*)",
      "Bash(git push origin master:*)",
      "Bash(git push origin release/*)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git checkout develop:*)",
      "Bash(git checkout main:*)",
      "Bash(gh pr create --base develop:*)",
      "Bash(gh pr create --base main:*)",
      "Bash(gh pr create --base master:*)",
      "Bash(gh release:*)",
      "Bash(gh workflow run:*)",
      "Bash(gh secret:*)",
      "Bash(gh repo delete:*)",
      "Bash(gh api -X DELETE:*)",
      "Bash(rm -rf /*)",
      "Bash(sudo:*)"
    ]
  }
}
